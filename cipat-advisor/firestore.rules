rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             (!('name' in data) || (data.name is string && data.name.size() >= 2)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() == 10)) &&
             (!('gardenType' in data) || data.gardenType in ['Farm', 'Home Garden', 'Greenhouse', 'Roof Top']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'location', 'gardenType', 'level', 'xp', 'experience', 'gardenSize', 'avatar']);
      
      match /chat_history/{chatId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      incoming().userId == request.auth.uid &&
                      incoming().timestamp == request.time;
      }

      match /activity_logs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      incoming().userId == request.auth.uid &&
                      incoming().timestamp == request.time;
      }
    }
  }
}
